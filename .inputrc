# set editing-mode vi
# set vi-ins-mode-string "\1\e[32m\2🅘 \1\e[0m\2"
# set vi-cmd-mode-string "\1\e[35m\2🅝 \1\e[0m\2"

# <tab> for completion.
# show-all-if-ambiguous is deliberately left off: .config/bash/30-tools.bash
# rebinds Tab to fzf-tab-completion, so readline never draws the candidate
# list itself (that list is plain terminal output and stays in the scrollback).
# Turn it back on if that binding is ever removed.

# ignore case on completion
set completion-ignore-case on

#
set mark-symlinked-directories on

# set page-completions off

set colored-stats on

set enable-bracketed-paste on

"\e[A": history-search-backward
"\e[B": history-search-forward

$if mode=vi
set show-mode-in-prompt on
set keymap vi-command

"H": beginning-of-line
"L": end-of-line

"gu": downcase-word
"gU": upcase-word

"n": history-search-backward
"N": history-search-forward

set keymap vi-insert

$endif

